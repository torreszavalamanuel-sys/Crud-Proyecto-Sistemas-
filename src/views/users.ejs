<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Usuarios</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
    <header class="navbar sticky-top bg-dark flex-md-nowrap p-2 shadow" data-bs-theme="dark">
      <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white fw-bold" href="/">DEM-Yuriria UG</a>
      <div class="d-flex align-items-center gap-2 me-3 ms-auto">
        <% if (user) { %>
          <span class="badge text-white px-3 py-2 fw-semibold" style="background-color: #0dcaf0;"><%= user.name %></span>
        <% } %>
        <a href="/logout" class="btn btn-danger btn-sm px-3">Salir</a>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row">
        <!-- Menú lateral -->
        <div class="sidebar border-end col-md-3 col-lg-2 p-0 bg-light" style="min-height: 100vh;">
          <div class="p-3">
            <ul class="nav flex-column gap-1">
              <li class="nav-item">
                <a class="nav-link text-primary fw-medium d-flex align-items-center gap-2" href="/">
                  <i class="bi bi-house-door-fill"></i> Dashboard
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-primary fw-medium d-flex align-items-center gap-2" href="/users">
                  <i class="bi bi-people-fill"></i> Usuarios
                </a>
              </li>
              <hr class="my-3">
              <li class="nav-item">
                <a class="nav-link text-primary fw-medium d-flex align-items-center gap-2" href="/logout">
                  <i class="bi bi-door-closed"></i> Sign out
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Contenido principal -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">Gestión de Usuarios</h2>
            <a href="/register" class="btn btn-primary d-flex align-items-center gap-2">
              <i class="bi bi-person-fill"></i> Nuevo usuario
            </a>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th scope="col">Nombre</th>
                  <th scope="col">Correo</th>
                  <th scope="col" class="text-end pe-4">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if (users && users.length > 0) { %>
                  <% users.forEach((u) => { %>
                    <tr>
                      <td class="fw-medium"><%= u.name %></td>
                      <td><%= u.email %></td>
                      <td class="text-end pe-3">
                        <a href="/edit-user/<%= u.id %>" class="btn btn-sm btn-outline-primary me-1">
                          <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a href="/delete-user/<%= u.id %>" onclick="return confirm('¿Seguro que deseas eliminar este usuario?')" class="btn btn-sm btn-outline-danger">
                          <i class="bi bi-trash"></i> Eliminar
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="text-center text-muted py-4">No hay usuarios registrados</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>