<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Usuario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="/css/dashboard.css" rel="stylesheet">
</head>
<body>
    <header class="navbar sticky-top bg-dark flex-md-nowrap p-2 shadow" data-bs-theme="dark">
      <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white fw-bold" href="/">DEM-Yuriria UG</a>
      <div class="d-flex align-items-center gap-2 me-3 ms-auto">
        <% if (user) { %>
          <span class="badge text-white px-3 py-2 fw-semibold" style="background-color: #0dcaf0;"><%= user.name %></span>
        <% } %>
        <a href="/logout" class="btn btn-danger btn-sm px-3">Salir</a>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row">
        <!-- Menú lateral -->
        <div class="sidebar border-end col-md-3 col-lg-2 p-0 bg-light" style="min-height: 100vh;">
          <div class="p-3">
            <ul class="nav flex-column gap-1">
              <li class="nav-item">
                <a class="nav-link text-primary fw-medium d-flex align-items-center gap-2" href="/">
                  <i class="bi bi-house-door-fill"></i> Dashboard
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link text-primary fw-medium d-flex align-items-center gap-2" href="/users">
                  <i class="bi bi-people-fill"></i> Usuarios
                </a>
              </li>
              <hr class="my-3">
              <li class="nav-item">
                <a class="nav-link text-primary fw-medium d-flex align-items-center gap-2" href="/logout">
                  <i class="bi bi-door-closed"></i> Sign out
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Contenido principal -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-4">
          <h2 class="fw-bold mb-4">Editar Usuario</h2>

          <div class="d-flex justify-content-center">
            <div class="card shadow-sm col-md-8 col-lg-6 border-0">
              <div class="card-header bg-primary text-white py-2 fw-semibold">
                Datos del usuario
              </div>
              <div class="card-body p-4 border rounded-bottom">
                <form action="/update-user" method="POST">
                  <input type="hidden" name="id" value="<%= editUser.id %>">
                  
                  <div class="mb-3">
                    <label class="form-label fw-medium">Nombre</label>
                    <input type="text" class="form-control" name="name" value="<%= editUser.name %>" required>
                  </div>

                  <div class="mb-3">
                    <label class="form-label fw-medium">Correo</label>
                    <input type="email" class="form-control" name="email" value="<%= editUser.email %>" required>
                  </div>

                  <div class="mb-4">
                    <label class="form-label fw-medium">Nueva contraseña</label>
                    <input type="password" class="form-control" name="password" placeholder="Dejar en blanco para no cambiarla">
                  </div>

                  <hr class="mb-3">

                  <div class="d-flex justify-content-end gap-2">
                    <a href="/users" class="btn btn-secondary px-3">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-3">Guardar cambios</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>